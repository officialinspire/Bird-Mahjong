{
  "name": "bird-mahjong",
  "private": true,
  "description": "Bird Mahjong \u2014 static site; npm is only used for dev checks.",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test:logic": "node --test \"tests/*.test.js\"",
    "test:crops": "python3 tools/verify_crops.py",
    "test:layout": "node tools/verify-layout.mjs",
    "test:play": "node tools/verify-play.mjs",
    "test": "npm run test:logic && npm run test:crops && npm run test:layout && npm run test:play && npm run test:save && npm run test:polish && npm run test:offline && npm run test:music && npm run test:calls && npm run test:release",
    "test:save": "node tools/verify-save.mjs",
    "test:polish": "node tools/verify-polish.mjs",
    "build:sw": "node tools/build-sw.mjs",
    "build:icons": "python3 tools/make_icons.py",
    "test:offline": "node tools/verify-offline.mjs",
    "test:release": "node tools/verify-release.mjs",
    "test:music": "node tools/verify-music.mjs",
    "test:calls": "node tools/verify-calls.mjs"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
